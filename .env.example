# ── Required ─────────────────────────────────────────────────────────────────

# Google Gemini API key — get one at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/thoughtmap

# Port for the Express API server
PORT=5000

# Base path for the Vite frontend (use / for local dev)
BASE_PATH=/

# ── Optional ──────────────────────────────────────────────────────────────────

# Comma-separated list of allowed CORS origins (production only).
# If unset, all origins are allowed in development and blocked in production.
# ALLOWED_ORIGINS=https://thoughtmap.example.com

# Log level: trace | debug | info | warn | error | fatal  (default: info)
# LOG_LEVEL=info

# Node environment: development | production
NODE_ENV=development

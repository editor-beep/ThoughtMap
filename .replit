modules = ["nodejs-24"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "sequential"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm install --frozen-lockfile"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=8081 BASE_PATH=/ pnpm --filter @workspace/living-thought-map run dev & PORT=8080 pnpm --filter @workspace/api-server run dev & wait"
waitForPort = 8081

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true
integrations = ["stripe:1.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[[ports]]
localPort = 3000
externalPort = 3002

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 80

[[ports]]
localPort = 8082
externalPort = 3003

[[ports]]
localPort = 8083
externalPort = 5000

[[ports]]
localPort = 19175
externalPort = 3000

[[ports]]
localPort = 23728
externalPort = 3001

[[ports]]
localPort = 23729
externalPort = 5173

[nix]
channel = "stable-25_05"

[userenv]

[userenv.development]
STRIPE_MONTHLY_PRICE_ID = "price_1TeXiVAsf0xa6pJgJvrrod5q"

[userenv.shared]
ADMIN_EMAILS = "editor@themeansofproduction.press"
